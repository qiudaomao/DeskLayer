    "Its catalog disappears from the library. Installed plugins are untouched.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カタログはライブラリから消えます。インストール済みのプラグインはそのまま残ります。"
          }
