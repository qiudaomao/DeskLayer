{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ (added)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（追加済み）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（已添加）"
          }
        }
      }
    },
    "%@ came from a store, so this is saved as a copy.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアから入手した %@ のため、これはコピーとして保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 来自插件商店，因此本次改写将另存为副本。"
          }
        }
      }
    },
    "%@ item": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個の項目"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个项目"
          }
        }
      }
    },
    "%@ was installed from %@. An update from the store would overwrite changes made here, so the rewrite is saved as a separate plugin.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$@ からインストールされました。ストアの更新でここでの変更が上書きされてしまうため、書き換えたものは別のプラグインとして保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 安装自 %2$@。商店更新会覆盖在此处所做的修改，因此改写结果会另存为独立插件。"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld item%@ on your desktop use it and will stop rendering.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップ上の %lld 個の項目%@がこれを使用しており、描画が停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面上有 %lld 个项目%@正在使用它，将停止渲染。"
          }
        }
      }
    },
    "A clock with a sweeping second hand and the date underneath": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秒針が滑らかに動き、下に日付が出る時計"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个带扫秒针、下方显示日期的时钟"
          }
        }
      }
    },
    "A new plugin": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいプラグイン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建插件"
          }
        }
      }
    },
    "A store is a JSON catalog listing plugins you can install. It becomes its own category in the library.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアはインストールできるプラグインを列挙した JSON カタログです。追加するとライブラリ内の独立したカテゴリになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件商店是一个列出可安装插件的 JSON 目录，添加后会成为插件库中的一个分类。"
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        }
      }
    },
