          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Describe a change and let a model rewrite this plugin": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更内容を説明すると、モデルがこのプラグインを書き換えます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述想要的改动，让模型重写这个插件"
          }
        }
      }
    },
    "Describe what you want. The model is given DeskLayer's plugin API and writes the JavaScript; nothing is installed until it passes validation.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作りたいものを書いてください。モデルは DeskLayer のプラグイン API を渡されて JavaScript を書きます。検証を通るまでインストールされません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述你想要的效果。模型会拿到 DeskLayer 的插件 API 并编写 JavaScript；只有通过校验才会安装。"
          }
        }
      }
    },
    "Description": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述"
          }
        }
      }
    },
    "DeskLayer": {
