    "Daily publish limit reached — try again tomorrow.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 日の公開上限に達しました。明日もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到每日发布上限——请明天再试。"
          }
