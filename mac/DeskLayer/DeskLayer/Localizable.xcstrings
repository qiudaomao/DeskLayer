    "Publishing shares %@ in the community store and opens a forum topic under your account, where people can discuss and cheer it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開すると %@ がコミュニティストアに掲載され、あなたのアカウントでフォーラムにトピックが作成されます。そこで議論や応援（いいね）が行われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布后，%@ 将上架社区商店，并以你的账号在论坛开设主题帖，大家可以在那里讨论和点赞。"
          }
        }
      }
    },
    "Publishing uses your forum account (bbs.byteplayer.app). Signing in opens the forum in your browser — no password ever passes through the app.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開にはフォーラムアカウント（bbs.byteplayer.app）を使います。サインインはブラウザで行われ、パスワードがアプリを通ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布使用你的论坛账号（bbs.byteplayer.app）。登录会在浏览器中进行——密码不会经过本应用。"
          }
        }
      }
    },
