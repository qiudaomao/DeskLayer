<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ships outside the App Store (Developer ID / notarized), so App
	     Sandbox is OFF: plugins can spawn processes for shell()/ssh() and
	     drive AppleScript. Keep Hardened Runtime on for notarization. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.qiudaomao.DeskLayer</string>
	</array>
</dict>
</plist>
